# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - PARCIAL 3
# Autores: Juan David Arboleda Vallecilla & Diego Diaz
# ==============================================================================

PORT=3000
NODE_ENV=development

# Motor de Base de Datos: 'sqlite' (predeterminado, cero configuración) o 'mysql'
DB_DIALECT=sqlite

# Ruta para la base de datos SQLite (si se usa sqlite)
SQLITE_PATH=./data/videojuegos.sqlite

# Configuración para MySQL (opcional, si se establece DB_DIALECT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ucp_parcial3_videojuegos
